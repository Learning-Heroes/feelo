{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(pnpm start)",
      "Bash(pnpm api:sync)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec tsc --noEmit:*)",
      "Bash(pnpm exec jest:*)",
      "Bash(pnpm expo start:*)",
      "Bash(pnpm expo install:*)",
      "Bash(pnpm dlx supabase migration new:*)",
      "Bash(pnpm dlx supabase migration list)",
      "Bash(pnpm dlx supabase db push)",
      "Bash(pnpm dlx supabase db push --include-seed)",
      "Bash(pnpm dlx supabase gen types typescript --linked:*)",
      "Bash(pnpm dlx supabase test db --linked)",
      "Bash(pnpm dlx supabase functions new:*)",
      "Bash(pnpm dlx supabase start)",
      "Bash(pnpm dlx supabase stop)",
      "Bash(pnpm dlx supabase status)",
      "Bash(pnpm dlx supabase db reset --local)",
      "Bash(pnpm dlx supabase migration list --local)",
      "Bash(pnpm dlx supabase gen types typescript --local:*)",
      "Bash(pnpm dlx supabase functions serve:*)",
      "Bash(pnpm dlx supabase test db --local)",
      "Bash(supabase migration new:*)",
      "Bash(deno test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "mcp__notion",
      "mcp__supabase"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./api/**)",
      "Write(./api/**)",
      "Edit(./postman/**)",
      "Write(./postman/**)",
      "Bash(*--project-ref*)",
      "Bash(*--db-url*)",
      "Bash(*db reset*--linked*)",
      "Bash(npx supabase link:*)",
      "Bash(pnpm dlx supabase link:*)",
      "Bash(npx supabase functions deploy:*)",
      "Bash(pnpm dlx supabase functions deploy:*)",
      "Bash(npx supabase secrets:*)",
      "Bash(pnpm dlx supabase secrets:*)",
      "Bash(supabase link:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(supabase secrets:*)",
      "Bash(*eas submit*)",
      "Bash(*eas update*)",
      "Bash(*eas build*production*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin staging:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-generated.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-after-edit.sh", "timeout": 120 }
        ]
      }
    ]
  }
}
